# Скопируйте в .env и заполните: cp .env.example .env

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me

# --- PostgreSQL ---
# localhost — для запуска бота вне Docker; в docker compose хост подменяется на "postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tg_bot
POSTGRES_USER=tg_bot
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ---
# localhost — для запуска бота вне Docker; в docker compose хост подменяется на "redis"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Обязателен: docker compose запускает Redis с requirepass
REDIS_PASSWORD=change-me-redis

# --- Поведение бота ---
# Сколько хранится кеш ответа на вопрос (сек). Кеш сбрасывается и при обновлении документации
ANSWER_CACHE_TTL_SECONDS=86400
# Не больше QUESTION_RATE_LIMIT вопросов за QUESTION_RATE_WINDOW_SECONDS от одного человека/чата
QUESTION_RATE_LIMIT=10
QUESTION_RATE_WINDOW_SECONDS=60
# Защита секретного пароля проекта от перебора: попыток за окно (сек)
PASSWORD_ATTEMPTS_LIMIT=5
PASSWORD_ATTEMPTS_WINDOW_SECONDS=900
# Сколько секунд создателю доступна кнопка «Показать пароль»
PASSWORD_REVEAL_TTL_SECONDS=600
# Максимум файлов документации за одну загрузку (каждый не больше 20 МБ — лимит Telegram)
DOCS_MAX_FILES=10

LOG_LEVEL=INFO
