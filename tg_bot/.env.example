# Скопируйте в .env и заполните: cp .env.example .env

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me

# --- PostgreSQL ---
# localhost — для запуска бота вне Docker; в docker compose хост подменяется на "postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tg_bot
POSTGRES_USER=tg_bot
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ---
# localhost — для запуска бота вне Docker; в docker compose хост подменяется на "redis"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Обязателен: docker compose запускает Redis с requirepass
REDIS_PASSWORD=change-me-redis

# --- Поведение бота ---
# Сколько хранится кеш ответа на вопрос (сек). Кеш сбрасывается и при обновлении документации
ANSWER_CACHE_TTL_SECONDS=86400
# Не больше QUESTION_RATE_LIMIT вопросов за QUESTION_RATE_WINDOW_SECONDS от одного человека/чата
QUESTION_RATE_LIMIT=10
QUESTION_RATE_WINDOW_SECONDS=60
# Защита секретного пароля проекта от перебора: попыток за окно (сек)
PASSWORD_ATTEMPTS_LIMIT=5
PASSWORD_ATTEMPTS_WINDOW_SECONDS=900
# Сколько секунд создателю доступна кнопка «Показать пароль»
PASSWORD_REVEAL_TTL_SECONDS=600
# Максимум файлов документации за одну загрузку (каждый не больше 20 МБ — лимит Telegram)
DOCS_MAX_FILES=10
# Постепенный показ ответа (черновик в личке, редактируемое сообщение в группе).
# false — ответ приходит целиком, как раньше
ANSWER_STREAMING_ENABLED=true
# За сколько секунд «допечатывается» ответ (0 — без анимации)
ANSWER_STREAM_REPLAY_SECONDS=1.5
# Пауза между кадрами в личке и в группе (сек)
ANSWER_STREAM_DRAFT_INTERVAL_SECONDS=0.3
ANSWER_STREAM_EDIT_INTERVAL_SECONDS=1.0
# Как часто обновлять «думаю…», пока ИИ отвечает (сек, меньше 30 — срока жизни черновика)
ANSWER_STREAM_KEEPALIVE_SECONDS=20

# --- RAG / LLM ---
# stub — dev/test без публикации; real — PG published snapshot + real provider.
# При RAG_MODE=real пустые LLM_BASE_URL/LLM_MODEL/LLM_API_KEY останавливают startup.
RAG_MODE=stub
RAG_QDRANT_PATH=data/qdrant
# Для внешнего Qdrant: RAG_QDRANT_URL и RAG_QDRANT_API_KEY вместо path
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
# OpenAI-compatible endpoint. Модель выбирается явно, например
# DeepSeek-V4.1-Flash-1017 или GLM-5.3-Flash.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Жёсткий лимит выходных токенов; уходит в OpenAI-compatible payload max_tokens.
LLM_MAX_OUTPUT_TOKENS=1024
# Не более N одновременно выполняемых provider generation в этом процессе.
# При занятости запрос получает busy до provider-вызова и не создаёт платную попытку.
LLM_MAX_CONCURRENT_GENERATIONS=1
# Включать только после проверки stream_options.include_usage на endpoint.
LLM_INCLUDE_USAGE=false
LLM_CHAT_COMPLETIONS_PATH=/chat/completions

# --- Расписание ---
# Часовой пояс заданий по расписанию (IANA)
SCHEDULER_TIMEZONE=Europe/Moscow
# Еженедельная сводка админам о вопросах без ответа: день недели (0 — понедельник) и час
DIGEST_WEEKDAY=0
DIGEST_HOUR=10

LOG_LEVEL=INFO
